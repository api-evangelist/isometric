{
  "opencollection": "1.0.0",
  "info": {
    "name": "Isometric Certify Data Ingestion Beneficiaries Refunds API",
    "version": "v0"
  },
  "items": [
    {
      "info": {
        "name": "Refunds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Refund",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.isometric.com/mrv/v0/refunds/:id",
            "headers": [
              {
                "name": "x-client-secret",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Information about a specific refund."
        },
        {
          "info": {
            "name": "Refund Credit Batches",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.isometric.com/mrv/v0/refunds/:id/credit_batches",
            "headers": [
              {
                "name": "x-client-secret",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List of credit batches in a given refund."
        }
      ]
    }
  ],
  "bundled": true
}