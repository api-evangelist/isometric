{
  "opencollection": "1.0.0",
  "info": {
    "name": "Isometric Certify Data Ingestion Beneficiaries Orders API",
    "version": "v0"
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.isometric.com/mrv/v0/orders/:id",
            "headers": [
              {
                "name": "x-client-secret",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Information about a specific order."
        },
        {
          "info": {
            "name": "Order Deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.isometric.com/mrv/v0/orders/:id/deliveries",
            "headers": [
              {
                "name": "x-client-secret",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "last",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              },
              {
                "name": "first",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List of deliveries for a given order.\n\nDeliveries are sorted by most recently delivered first."
        }
      ]
    }
  ],
  "bundled": true
}